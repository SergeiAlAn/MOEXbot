# Telegram
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# ID чата для уведомлений (необязательно, определится после /start)
CHAT_ID=

# Расписание (Europe/Moscow)
START_NOTIFICATION_TIME=10:00
END_NOTIFICATION_TIME=19:00
MIDNIGHT_NOTIFICATION_TIME=00:00

# Интервал промежуточных уведомлений (минуты): 30, 60, 120, 180, 240
DEFAULT_INTERVAL_MINUTES=60

# Тестовый режим: при запуске сразу отправить status и прогнать джобы
TEST_MODE=false

# Тикеры ISS MOEX (можно переопределить)
# IMOEX  = основная сессия; IMOEX2 = все сессии (отображается как MOEX2)
MOEX_SECID=IMOEX
MOEX2_SECID=IMOEX2
